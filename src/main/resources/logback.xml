<configuration>
  <!-- Keep logback's own start-up chatter out of a CLI's output. -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

  <!--
    Logs go to stderr (never stdout, which is reserved for command output so that
    `taskflow list json | jq` always works) in logfmt, which is greppable by humans
    and parseable by log shippers without a custom grok pattern.

    Level: WARN by default; -v => INFO, -vv => DEBUG, or set TASKFLOW_LOG_LEVEL.
  -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>ts=%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level logger=%logger{0} command=%X{command} command_id=%X{command_id} msg="%msg"%n</pattern>
    </encoder>
  </appender>

  <root level="${TASKFLOW_LOG_LEVEL:-WARN}">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
